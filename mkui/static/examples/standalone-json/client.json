{
  "app": {
    "title": "mkui demo",
    "theme": "dark",
    "version": "1.0",
    "description": "A workspace of floating frames and dockable panes, built from this JSON file alone: no server, no JavaScript.",
    "copyright": "MIT licensed.",
    "links": [
      { "label": "README", "href": "https://github.com/markuskimius/mkui#readme" }
    ]
  },
  "state": {
    "status": { "message": "Ready" }
  },
  "menubar": [
    {
      "label": "File",
      "items": [
        { "label": "Welcome…", "action": "dialog.open", "args": "welcome" },
        { "label": "Show a notice", "action": "dialog.alert",
          "args": { "title": "Notice", "kind": "success", "timeout": 8, "suppress": "demo.notice",
                    "message": "A message box is one action: dialog.alert, with the message as its args.\nThis one closes itself (timeout) unless you click or type in it, and can be told not to come back (suppress)." } },
        { "label": "Show Notices Again", "action": "dialog.resetSuppressed", "args": "demo.notice",
          "showWhen": "state.dialog.suppressed['demo.notice'] != NULL" },
        { "sep": true },
        { "label": "Quit", "action": "app.quit", "confirm": "Quit the demo?" }
      ]
    },
    {
      "label": "Window",
      "items": [
        { "label": "Explorer",  "action": "pane.show", "args": "explorer" },
        { "label": "Editor",    "action": "pane.show", "args": "editor" },
        { "label": "Preview",   "action": "pane.show", "args": "preview" },
        { "label": "Console",   "action": "pane.show", "args": "console" },
        { "label": "Inspector", "action": "pane.show", "args": "inspector" },
        { "sep": true },
        { "label": "Cascade", "action": "window.cascade", "disabled": "LEN(panes) < 2", "disabledTitle": "Only one window is open" },
        {
          "label": "Tile",
          "items": [
            { "label": "Horizontal", "action": "window.tileH" },
            { "label": "Vertical",   "action": "window.tileV" },
            { "label": "Grid",       "action": "window.grid" }
          ]
        }
      ]
    },
    {
      "label": "Help",
      "items": [
        { "label": "About mkui demo", "action": "dialog.about" }
      ]
    }
  ],
  "statusbar": {
    "left":  [{ "type": "text", "bind": "status.message" }],
    "right": [{ "type": "text", "text": "mkui v0.1" }]
  },
  "dialogs": {
    "welcome": {
      "title": "Welcome",
      "kind": "info",
      "heading": "Welcome to ${app.title}",
      "message": [
        "Drag a tab out of its frame to tear it off; drop it on another frame's edge to dock it there.",
        "This box is a named dialog under the config's \"dialogs\" key, opened from the File menu by dialog.open."
      ],
      "links": [{ "label": "Configs in the README", "href": "https://github.com/markuskimius/mkui#configs" }],
      "buttons": [
        { "label": "Tile the windows", "kind": "primary", "action": "window.grid" },
        { "label": "Close", "cancel": true, "default": true }
      ]
    }
  },
  "panes": {
    "explorer": {
      "title": "Explorer",
      "widgets": [
        { "type": "text", "text": "Project files would go here. Drag the Explorer tab out of this frame to tear it off, drop it on another frame's edge to re-dock." }
      ]
    },
    "editor": {
      "title": "Editor",
      "widgets": [
        { "type": "text", "text": "Editor content. This frame holds two tabs — Editor and Preview. Try dragging the Preview tab out." }
      ]
    },
    "preview": {
      "title": "Preview",
      "widgets": [
        { "type": "text", "text": "Preview pane." }
      ]
    },
    "console": {
      "title": "Console",
      "widgets": [
        { "type": "text", "text": "Console log stream would go here." },
        { "type": "button", "label": "Clear", "action": "dialog.confirm",
          "args": { "title": "Clear console", "kind": "danger", "message": "Clear the console log?\nThis cannot be undone.", "ok": "Clear", "arm": 2,
                    "details": "A danger confirm: Cancel is the default, Enter never presses Clear,\nand arm keeps Clear shut for two seconds. Like every confirm it is modal.",
                    "then": { "action": "dialog.alert", "args": { "title": "Console", "kind": "success", "message": "Cleared." } } } }
      ]
    },
    "inspector": {
      "title": "Inspector",
      "widgets": [
        { "type": "text", "text": "Inspector panel — a fourth floating frame to demonstrate multiple top-level frames." }
      ]
    }
  },
  "frames": [
    {
      "id": "left",
      "x": 0.02, "y": 0.03, "w": 0.22, "h": 0.94,
      "layout": { "type": "tabs", "active": 0, "children": ["explorer"] }
    },
    {
      "id": "main",
      "x": 0.26, "y": 0.03, "w": 0.48, "h": 0.60,
      "layout": { "type": "tabs", "active": 0, "children": ["editor", "preview"] }
    },
    {
      "id": "bottom",
      "x": 0.26, "y": 0.65, "w": 0.48, "h": 0.32,
      "layout": { "type": "tabs", "active": 0, "children": ["console"] }
    },
    {
      "id": "right",
      "x": 0.76, "y": 0.03, "w": 0.22, "h": 0.55,
      "layout": { "type": "tabs", "active": 0, "children": ["inspector"] }
    }
  ]
}
